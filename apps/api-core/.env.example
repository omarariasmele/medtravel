# ── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL 16 ─────────────────────────────────────────────────
# app_runtime/audit_writer/etc. son roles NOLOGIN (000_extensions.sql) —
# no se puede conectar directamente como ellos. DB_USERNAME debe ser un
# rol LOGIN que sea miembro de app_runtime (ver
# src/database/sql/local-dev-login-role.sql y el README).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medtravel_app
DB_PASSWORD=change-me
DB_DATABASE=medtravel
DB_SSL=false

# Rol usado solo para correr migraciones (000_extensions..009_tests),
# necesita permisos de owner/DDL. Nunca usar este rol en runtime.
DB_MIGRATION_USERNAME=migration_owner
DB_MIGRATION_PASSWORD=change-me

# Clave usada por core.encrypt_pii/decrypt_pii (SET a nivel de conexión,
# nunca por request). Debe coincidir con la infraestructura del schema.
DB_ENCRYPTION_KEY=change-me

# Clave HMAC para calcular email_blind_index (core.blind_index) al hacer
# login — debe ser la MISMA clave usada al crear cada core.users.email_blind_index.
DB_BLIND_INDEX_KEY=change-me

# ── Redis / BullMQ ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth (JWT) ────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS / Socket.io ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# Orígenes CORS adicionales separados por coma (opcional, dev) — ej.
# apps/mobile corriendo en Flutter web. Nunca se usa para armar URLs.
CORS_EXTRA_ORIGINS=

# ── IA — Anthropic (Claude), ya integrado en /me/assistant/ask ──────
# Opcional: sin ella, el asistente responde con ayuda estática.
ANTHROPIC_API_KEY=

# ── IA — OpenAI (AI Gateway real: captura de salud por chat) ───────
# La clave real SOLO se pega en el .env local (nunca acá, nunca en
# Flutter/portal web, nunca en tests/docs/logs). Con AI_ENABLED=false
# el backend arranca sin necesitar ninguna clave.
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_ENABLED=false
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_USER_DAY=10
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10

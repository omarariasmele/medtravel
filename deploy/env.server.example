# ─────────────────────────────────────────────────────────────────
# .env de PRODUCCION — vive SOLO en el servidor, en
# C:\MedTravelApp\apps\api-core\.env  (nunca en git, nunca en el
# release: update-server.ps1 jamas lo pisa).
#
# Para armarlo: copiar el .env de desarrollo
# (D:\Dev\Desarrollo_MedtravelApp\nestjs-api\apps\api-core\.env),
# pegarlo aca y cambiar SOLO lo que se marca abajo. Todos los secretos
# (DB_PASSWORD, DB_ENCRYPTION_KEY, DB_BLIND_INDEX_KEY, JWT_SECRET,
# OPENAI_API_KEY) tienen que ser LOS MISMOS que los de desarrollo:
# encrypt_pii/decrypt_pii y el blind index de email son deterministicos
# con esas claves — si cambian, los datos ya guardados dejan de poder
# leerse y nadie puede loguearse.
# ─────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────
# CAMBIA: en la PC es development.
NODE_ENV=production
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────
# CAMBIA: la base ahora corre en ESTA misma maquina, asi que la app le
# pega por loopback en vez de cruzar la LAN. El puerto sigue siendo
# 5433 (no es el 5432 por defecto).
# Verificar que pg_hba.conf tenga una linea para 127.0.0.1/32 con el
# rol medtravel_app, si no la conexion por loopback es rechazada.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=medtravel_app
DB_PASSWORD=<mismo que en desarrollo>
DB_DATABASE=medtravelapp
DB_SSL=false

# Solo para migraciones manuales. El arranque NO corre migraciones
# (typeorm.config.ts tiene synchronize:false y migrationsRun:false), asi
# que publicar una version nueva nunca toca el schema por su cuenta.
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=<mismo que en desarrollo>

DB_ENCRYPTION_KEY=<MISMO que en desarrollo — si cambia, no se leen los datos ya guardados>
DB_BLIND_INDEX_KEY=<MISMO que en desarrollo — si cambia, nadie puede loguearse>

# ── Redis / BullMQ (placeholder, no se usa todavia) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<mismo que en desarrollo>

# ── Auth (JWT) ────────────────────────────────────────────────────
# Si cambia JWT_SECRET, todas las sesiones abiertas se invalidan.
JWT_SECRET=<mismo que en desarrollo>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS / links publicos ─────────────────────────────────────────
# NO CAMBIA: el dominio y los puertos publicos son los mismos, solo se
# mueve la maquina que los atiende. Es la base con la que se arman los
# links de QR/compartir, reset de password y tokens de emergencia.
CORS_ORIGIN=https://medtravelapp.oysgroup.com.ar:8444

# CAMBIA: en produccion no hay nada corriendo en localhost:5173/8765.
# Se deja el acceso por LAN (puerto 8101 de Caddy) para poder probar
# desde la oficina sin pasar por internet.
CORS_EXTRA_ORIGINS=http://192.168.0.150:8101

# ── IA — OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=<mismo que en desarrollo>
AI_PROVIDER=openai
AI_ENABLED=true
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_USER_DAY=100
# OJO: este presupuesto es aparte del de tu entorno de desarrollo.
AI_DAILY_BUDGET_USD=20
AI_MONTHLY_BUDGET_USD=200
